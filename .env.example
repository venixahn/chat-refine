PORT=3000
SESSION_SECRET=change-me-on-this-machine
# Blank uses Google STUN so peers can connect across the internet.
# ICE_SERVERS=[] keeps LAN-only host candidates.
# Hard NAT: run coturn (see docs/Setup.md) then point ICE_SERVERS at it:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:192.168.1.10:3478","username":"chat","credential":"change-this-turn-secret"}]
ICE_SERVERS=
